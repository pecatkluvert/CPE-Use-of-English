{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/english-practice/unit.schema.json",
  "title": "English Practice unit",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "exercises"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "heading",
                "explanation",
                "examples"
              ],
              "properties": {
                "heading": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "title",
        "instructions",
        "questions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "passage": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "wordBank": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "lessonIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guidance": {
          "type": "string"
        },
        "answerSource": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "answers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "keyword": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "options": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "string"
          }
        },
        "hint": {
          "type": "string"
        }
      }
    }
  }
}
